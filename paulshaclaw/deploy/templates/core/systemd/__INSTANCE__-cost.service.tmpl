[Unit]
Description=__INSTANCE__ cost refresh service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
EnvironmentFile=%h/.agents/core/runtime/__INSTANCE__.env
EnvironmentFile=%h/.agents/core/runtime/__INSTANCE__-cost.env
ExecStart=__PYTHON__ -m paulshaclaw.launcher.services cost
KillMode=control-group
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
